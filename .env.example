# Copiar a .env (junto al docker-compose.yml) y completar. .env NO se sube al repositorio.
# Para aplicar cambios hay que recrear el contenedor (restart no basta):
#   docker compose up -d <servicio>

# OAuth de usuario de Google Drive. La app OAuth debe estar PUBLICADA ("En produccion"):
# en modo prueba el refresh token vence cada 7 dias.
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=

# Id de la carpeta de PRODUCCION que antes se montaba con rclone (contiene Firmas/ y Recibos/).
# Es la parte final de https://drive.google.com/drive/folders/<ID>
DRIVE_ROOT_FOLDER_ID=

# Carpeta de Drive del servicio de pruebas (cartera-temporal-back-test). No usar la de produccion.
DRIVE_ROOT_FOLDER_ID_TEST=
